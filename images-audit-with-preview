javascript:(async function() { const newTab = window.open('', '_blank'); newTab.document.write('<html><head><title>Image SEO Audit</title><style>body{font-family:system-ui,sans-serif;background-color:#f8f9fa;color:#212529;margin:20px}h2,h3{color:#343a40}table{width:100%;border-collapse:collapse;margin-top:20px;box-shadow:0%202px%204px%20rgba(0,0,0,.1);font-size:14px;table-layout:fixed}th,td{padding:10px%2012px;border:1px%20solid%20#dee2e6;text-align:left;vertical-align:top}th{background-color:#e9ecef;font-weight:600;position:sticky;top:0}tr:nth-child(even){background-color:#fff}img{max-width:100px;max-height:100px;height:auto;border-radius:4px;display:block;margin:auto}a{color:#007bff;text-decoration:none}a:hover{text-decoration:underline}td.wrap-text{max-width:300px;overflow-wrap:break-word;word-break:break-word}.status-ok{color:#198754}.status-bad{color:#dc3545;font-weight:bold}.status-warn{color:#ffc107;font-weight:bold}.chip{padding:2px%208px;border-radius:12px;font-size:12px;font-weight:500;display:inline-block}.chip-ok{background-color:#d1e7dd;color:#0a3622}.chip-bad{background-color:#f8d7da;color:#58151c}.chip-warn{background-color:#fff3cd;color:#664d03}%3C/style%3E%3C/head%3E%3Cbody%3E%3Ch2%3ERunning%20Image%20SEO%20Audit...%3C/h2%3E%3Cp%3EPlease%20wait,%20analyzing%20all%20images%20on%20the%20page.%3C/p%3E%3C/body%3E%3C/html%3E');%20try%20{%20const%20getImageData%20=%20async%20(img)%20=%3E%20{%20const%20rect%20=%20img.getBoundingClientRect();%20const%20isAboveFold%20=%20rect.top%20%3C%20window.innerHeight%20&&%20rect.bottom%20%3E=%200;%20const%20data%20=%20{%20src:%20img.src,%20alt:%20img.alt%20||%20'',%20name:%20'',%20type:%20'',%20title:%20img.title%20||%20'',%20isLinked:%20false,%20linkHref:%20'',%20caption:%20'',%20loading:%20img.getAttribute('loading')%20||%20'eager%20(default)',%20isAboveFold:%20isAboveFold%20};%20if%20(img.src.startsWith('data:image/svg+xml'))%20{%20data.name%20=%20'[Inline%20SVG%20Data]';%20data.type%20=%20'svg';%20}%20else%20if%20(img.src.startsWith('data:'))%20{%20const%20match%20=%20img.src.match(/^data:image\/([^;]+);/);%20data.name%20=%20%60[Inline%20${match?match[1].toUpperCase():'Data'}]%60;%20data.type%20=%20match%20?%20match[1]%20:%20'';%20}%20else%20{%20try%20{%20data.name%20=%20new%20URL(img.src).pathname.split('/').pop();%20}%20catch%20(e)%20{%20data.name%20=%20img.src.split('/').pop().split('?')[0];%20}%20}%20const%20link%20=%20img.closest('a');%20if%20(link)%20{%20data.isLinked%20=%20true;%20data.linkHref%20=%20link.href;%20}%20const%20figure%20=%20img.closest('figure');%20if%20(figure)%20{%20const%20figcaption%20=%20figure.querySelector('figcaption');%20if%20(figcaption)%20{%20data.caption%20=%20figcaption.textContent.trim();%20}%20}%20try%20{%20const%20response%20=%20await%20fetch(img.src,%20{%20mode:%20'cors'%20});%20if%20(!response.ok)%20throw%20new%20Error('Network%20error');%20const%20blob%20=%20await%20response.blob();%20data.size%20=%20(blob.size%20/%201024).toFixed(2);%20data.type%20=%20data.type%20||%20blob.type.replace('image/',%20'');%20const%20tempImg%20=%20new%20Image();%20tempImg.src%20=%20URL.createObjectURL(blob);%20await%20new%20Promise(r%20=%3E%20tempImg.onload%20=%20r);%20data.dimensions%20=%20%60${tempImg.naturalWidth}%20&times;%20${tempImg.naturalHeight}%60;%20}%20catch%20(error)%20{%20data.size%20=%20'N/A';%20data.type%20=%20data.type%20||%20data.name.split('.').pop()%20||%20'N/A';%20data.dimensions%20=%20%60${img.naturalWidth}%20&times;%20${img.naturalHeight}%60;%20}%20return%20data;%20};%20const%20imageElements%20=%20Array.from(document.querySelectorAll('img'));%20const%20promises%20=%20imageElements.map(img%20=%3E%20getImageData(img));%20const%20allImageData%20=%20await%20Promise.all(promises);%20const%20totalImages%20=%20allImageData.length;%20const%20missingAltCount%20=%20allImageData.filter(d%20=%3E%20d.alt%20===%20'').length;%20const%20nextGenFormats%20=%20['webp',%20'avif',%20'svg'];%20let%20tableRows%20=%20'';%20allImageData.forEach(data%20=%3E%20{%20const%20altStatus%20=%20data.alt%20?%20'status-ok'%20:%20'status-bad';%20const%20altText%20=%20data.alt%20||%20'MISSING';%20const%20formatClass%20=%20nextGenFormats.includes(data.type.toLowerCase())%20?%20'chip-ok'%20:%20'chip-warn';%20let%20loadingRec%20=%20'';%20if%20(data.loading%20===%20'lazy'%20&&%20data.isAboveFold)%20{%20loadingRec%20=%20%60%3Cspan%20class=%22chip%20chip-bad%22%3EDon't%20lazy%20load%20LCP%20candidates!%3C/span%3E%60;%20}%20else%20if%20(data.loading%20!==%20'lazy'%20&&%20!data.isAboveFold)%20{%20loadingRec%20=%20%60%3Cspan%20class=%22chip%20chip-warn%22%3EConsider%20lazy%20loading.%3C/span%3E%60;%20}%20else%20{%20loadingRec%20=%20%60%3Cspan%20class=%22chip%20chip-ok%22%3EGood%3C/span%3E%60;%20}%20tableRows%20+=%20%60%3Ctr%3E%20%3Ctd%3E%3Ca%20href=%22${data.src}%22%20target=%22_blank%22%3E%3Cimg%20src=%22${data.src}%22%20alt=%22Preview%22%3E%3C/a%3E%3C/td%3E%20%3Ctd%20class=%22wrap-text%20${altStatus}%22%3E${altText}%3C/td%3E%20%3Ctd%20class=%22wrap-text%22%3E${data.name}%3C/td%3E%20%3Ctd%20class=%22wrap-text%22%3E%3Ca%20href=%22${data.src}%22%20target=%22_blank%22%20title=%22${data.src}%22%3EView%20Link%3C/a%3E%3C/td%3E%20%3Ctd%3E${data.size}%20KB%3C/td%3E%20%3Ctd%3E${data.dimensions}%3C/td%3E%20%3Ctd%3E%3Cspan%20class=%22chip%20${formatClass}%22%3E${data.type}%3C/span%3E%3C/td%3E%20%3Ctd%3E${data.loading.charAt(0).toUpperCase()%20+%20data.loading.slice(1)}%3C/td%3E%20%3Ctd%3E${loadingRec}%3C/td%3E%20%3Ctd%3E${data.isLinked%20?%20%60Yes%20(%3Ca%20href='${data.linkHref}'%20target='_blank'%3ELink%3C/a%3E)%60%20:%20'No'}%3C/td%3E%20%3Ctd%3E${data.caption%20||%20'None'}%3C/td%3E%20%3C/tr%3E%60;%20});%20const%20finalHtml%20=%20%60%3Ch2%3EImage%20SEO%20Audit%20Report%3C/h2%3E%3Ch3%3ETotal%20Images:%20${totalImages}%20|%20%3Cspan%20class=%22status-bad%22%3EMissing%20Alt%20Text:%20${missingAltCount}%3C/span%3E%3C/h3%3E%3Ctable%3E%3Cthead%3E%3Ctr%3E%3Cth%3EImage%3C/th%3E%3Cth%3EAlt%20Text%3C/th%3E%3Cth%3EFilename%3C/th%3E%3Cth%3EImage%20URL%3C/th%3E%3Cth%3ESize%3C/th%3E%3Cth%3EDimensions%3C/th%3E%3Cth%3EFormat%3C/th%3E%3Cth%3ELoading%3C/th%3E%3Cth%3ERecommendation%3C/th%3E%3Cth%3EIs%20Link?%3C/th%3E%3Cth%3EFigcaption%3C/th%3E%3C/tr%3E%3C/thead%3E%3Ctbody%3E${tableRows}%3C/tbody%3E%3C/table%3E%60;%20newTab.document.body.innerHTML%20=%20finalHtml;%20}%20catch%20(e)%20{%20newTab.document.body.innerHTML%20=%20%60%3Ch2%3EAn%20error%20occurred:%3C/h2%3E%3Cp%3E${e.message}%3C/p%3E%60;%20}%20})();
